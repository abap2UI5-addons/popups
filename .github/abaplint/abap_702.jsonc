{
  "global": {
    "files": "/../../src/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/open-abap/open-abap-core",
      "folder": "/deps",
      "files": "/src/**/*.*"
    },
    {
      // the downported form of the release the other configs pin - moved with
      // them by scripts/core-pin.mjs (abap2UI5 CONVENTIONS §9)
      "url": "https://github.com/abap2UI5/abap2UI5",
      "branch": "1.146.0-702",
      "folder": "/abap2UI5",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5-addons/layout-management",
      "branch": "702",
      "folder": "/abap2UI5-layout",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v702",
    "errorNamespace": "."
  },
  "rules": {
    "downport": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "definitions_top": true,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "uncaught_exception": true,
    "unknown_types": true,
    "xml_consistency": true
  }
}
