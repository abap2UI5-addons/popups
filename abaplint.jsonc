{
  "global": {
    "files": "/src/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2305-api-intersect-702",
      "folder": "/deps",
      "files": "/src/**/*.*"
    },
    {
      // A release tag, not main: users install a release next to this addon
      // (abap2UI5 CONVENTIONS §9). scripts/core-pin.mjs reads and moves it in
      // every abaplint config at once, bump-core moves it weekly after the gates
      // passed on the new tag, and the weekly canary run lints once against main.
      "url": "https://github.com/abap2UI5/abap2UI5",
      // 1.151.0 - back to its tag once it is cut
      "branch": "main",
      "folder": "/abap2UI5",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5-addons/layout-management",
      // layout-management main - its release tag once one is cut
      "branch": "main",
      "folder": "/layout-management",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v750",
    "errorNamespace": "."
  },
  "rules": {
    "downport": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "definitions_top": false,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "uncaught_exception": true,
    "unknown_types": true,
    "whitespace_end": true,
    "xml_consistency": true,
    "exporting": true,
    "omit_parameter_name": true,
    "prefix_is_current_class": true,
    // the rest of abap2UI5's rule set (abaplint.jsonc of abap2UI5/abap2UI5),
    // with its settings; where a rule excludes /src/00/ (the vendored
    // abap-util copy), its findings sit only there
    "7bit_ascii": true,
    "add_test_attributes": true,
    "aff_and_xml": true,
    "allowed_object_naming": true,
    "begin_single_include": true,
    "call_transaction_authority_check": true,
    "catch_and_raise": true,
    "cds_association_name": true,
    "cds_field_order": true,
    "cds_parser_error": true,
    "chain_mainly_declarations": true,
    "change_if_to_case": true,
    "check_abstract": true,
    "check_text_elements": true,
    "check_transformation_exists": true,
    "classic_exceptions_overlap": true,
    "clear_exporting_parameters": true,
    "cloud_types": true,
    "colon_missing_space": true,
    "constant_classes": true,
    "constructor_visibility_public": true,
    "contains_tab": true,
    "cyclic_oo": {
      "exclude": [],
      "skip": [
        "Z2UI5_IF_APP",
        "Z2UI5_IF_CLIENT",
        "Z2UI5_CL_UI5_ACTION",
        "Z2UI5_CL_UI5_HANDLER"
      ],
      "skipSharedMemory": true,
      "skipTestclasses": true
    },
    "db_operation_in_loop": true,
    "description_empty": true,
    "dynpro_checks": true,
    "easy_to_find_messages": true,
    "empty_event": true,
    "empty_statement": true,
    "empty_structure": {
      "loopAllowIfSubrc": true,
      "loop": false,
      "if": true,
      "while": true,
      "case": true,
      "select": true,
      "do": true,
      "at": true,
      "try": true,
      "when": false,
      "catch": true,
      "exclude": [
        "/src/00/"
      ]
    },
    "exit_or_check": true,
    "expand_macros": true,
    "fm_global_parameters_obsolete": true,
    "forbidden_identifier": true,
    "forbidden_pseudo_and_pragma": {
      "exclude": [],
      "ignoreGlobalClassDefinition": false,
      "ignoreGlobalInterface": false,
      "pragmas": [],
      "pseudo": [],
      "severity": "Error"
    },
    "forbidden_void_type": {
      "check": [
        "^boole_d$",
        "^char10$",
        "^char12$",
        "^char2$",
        "^char20$",
        "^char30$",
        "^char4$",
        "^char50$",
        "^char70$",
        "^cl_abap_syst",
        "^cl_aff_",
        "^cl_aucv_test_runner_abstract$",
        "^cl_aucv_test_runner_standard$",
        "^cl_aunit_assert$",
        "^cl_axt_dbtable$",
        "^cl_blue_wb_utility$",
        "^cl_oo_source$",
        "^/ui2/cl_",
        "^cl_saunit_internal_result$",
        "^cl_srvd_wb_object_data$",
        "^cl_wb_object_operator_factory$",
        "^cl_wer_const$",
        "^cl_xco_",
        "^cx_aff_",
        "^cx_wb_object_operation_error$",
        "^cx_xco_",
        "^flag$",
        "^i18_a_langiso2$",
        "^if_adt_lock_handle$",
        "^if_aff_",
        "^if_satc_ci_variant_access$",
        "^if_saunit_internal_result$",
        "^if_saunit_internal_result_type$",
        "^if_srvd_types$",
        "^if_wb_adt_plugin_resource_co$",
        "^if_wb_object_data_selection_co$",
        "^if_wb_object_operator$",
        "^if_xco_",
        "^int4$",
        "^numc2$",
        "^sabp_t_tadir_keys$",
        "^sap_bool$",
        "^srcsystem$",
        "^stringtab$",
        "^sychar01$",
        "^sychar10$",
        "^sychar70$",
        "^sydatum$",
        "^sylangu$",
        "^syst_title$",
        "^syuzeit$",
        "^feld$",
        "^abap_boolean$"
      ],
      "exclude": []
    },
    "form_tables_obsolete": true,
    "fully_type_constants": {
      "checkData": true,
      "exclude": []
    },
    "function_module_recommendations": true,
    "functional_writing": {
      "exclude": [],
      "ignoreExceptions": true
    },
    "identical_conditions": true,
    "identical_contents": true,
    "identical_form_names": true,
    "identical_move": true,
    "if_in_if": true,
    "implicit_start_of_selection": true,
    "index_completely_contained": true,
    "inline_data_old_versions": true,
    "intf_referencing_clas": {
      "allow": [
        "^cl_abap_",
        // z2ui5_if_popup_embed hands over the node of the host view
        "^z2ui5_cl_ui5_view_builder$"
      ],
      "exclude": []
    },
    "invalid_table_index": true,
    "line_break_style": true,
    "local_testclass_consistency": true,
    "macro_naming": true,
    "main_file_contents": true,
    "many_parentheses": true,
    "max_one_method_parameter_per_line": true,
    "max_one_statement": true,
    "message_exists": true,
    "method_overwrites_builtin": true,
    "mix_returning": true,
    "modify_only_own_db_tables": {
      "exclude": [],
      "ownTables": "^[yz]",
      "reportDynamic": true
    },
    "msag_consistency": true,
    "names_no_dash": true,
    "nesting": {
      "depth": 5,
      "exclude": []
    },
    "newline_between_methods": true,
    "no_aliases": true,
    "no_chained_assignment": true,
    "no_comments_between_methods": true,
    "no_external_form_calls": true,
    "no_yoda_conditions": true,
    "nrob_consistency": true,
    "obsolete_statement": true,
    "omit_preceding_zeros": true,
    "omit_receiving": true,
    "parser_702_chaining": true,
    "parser_bad_exceptions": true,
    "parser_missing_space": true,
    "pragma_style": true,
    "prefer_abap_bool": true,
    "prefer_abap_bool_values": true,
    "prefer_is_not": true,
    "prefer_pragmas": true,
    "prefer_raise_exception_new": true,
    "prefer_returning_to_exporting": true,
    "prefer_xsdbool": true,
    "preferred_compare_operator": true,
    "preferred_parameter_ignored": true,
    "reduce_procedural_code": true,
    "reduce_string_templates": true,
    "redundant_conversion": true,
    "release_idoc": true,
    "remove_descriptions": {
      "exclude": [],
      "ignoreExceptions": false,
      "ignoreWorkflow": false,
      "severity": "Error"
    },
    "rfc_error_handling": true,
    "select_performance": true,
    "select_single_full_key": true,
    "selection_screen_naming": true,
    "sequential_blank": {
      "lines": 4,
      "exclude": [],
      "severity": "Warning"
    },
    "sicf_consistency": true,
    "sql_escape_host_variables": true,
    "sql_value_conversion": true,
    "static_call_via_instance": {
      "allowInTestclassIncludes": false,
      "exclude": []
    },
    "superfluous_value": true,
    "sy_modification": true,
    "tabl_enhancement_category": true,
    "tables_declared_locally": true,
    "try_without_catch": true,
    "type_form_parameters": true,
    "unnecessary_loop_guard": true,
    "unnecessary_pragma": true,
    "unnecessary_return": true,
    "unreachable_code": true,
    "unsecure_fae": true,
    "unused_ddic": true,
    "unused_macros": true,
    "unused_methods": true,
    "unused_types": {
      "exclude": [],
      "severity": "Error",
      "skipNames": []
    },
    "unused_variables": {
      "skipAbstract": false,
      "severity": "Error",
      "skipNames": [
        "lv_dummy",
        "lv_dummy2",
        "lv_dummy3",
        "lv_dummy4",
        "<dummy>"
      ],
      "exclude": [
        "/src/00/"
      ]
    },
    "use_class_based_exceptions": true,
    "use_line_exists": true,
    "use_message_class": true,
    "use_new": true,
    "when_others_last": true,
    "wrong_abapdoc_position": true,
    "xml_bom": true,
    // added 2026-11: the rules of abap2UI5's abaplint.jsonc this repository
    // passes without a finding, with its settings, and allowed_object_types
    // with the object types this repository ships
    "abapdoc_html_tag": true,
    "abapdoc_leading_at": true,
    "abapdoc_parameter_names": true,
    "abapdoc_shorttext_length": true,
    "allowed_object_types": {
      "allowed": [
        "CLAS",
        "DEVC",
        "INTF"
      ]
    },
    "bound_check_after_create": true,
    "cds_comment_style": true,
    "cds_legacy_view": true,
    "changing_sorted_line": true,
    "clear_after_declaration": true,
    "clear_before_overwrite": true,
    "constant_condition": true,
    "copy_of_initial_variable": true,
    "delete_index_in_loop": true,
    "final_newline": true,
    // an allow list matching no object: the default, empty, allows every one
    "forbidden_kernel_write": {
      "allow": [
        "^$"
      ]
    },
    "identical_descriptions": true,
    "inline_packed_computation": true,
    "no_mandt_in_database_operations": true,
    "object_naming": {
      "sxci": "^Z",
      "enhs": "^Z",
      "enho": "^Z",
      "cmod": "^Z",
      "form": "^Z",
      "sfpf": "^Z",
      "sfpi": "^Z",
      "aqqu": "^Z",
      "aqsg": "^Z",
      "aqbg": "^Z",
      "suso": "^Z",
      "sucu": "^Z",
      "wdya": "^Z",
      "wdyn": "^Z",
      "severity": "Error",
      "patternKind": "required",
      "ignoreNames": [],
      "ignorePatterns": [],
      "clas": "^Z2UI5_C(L|X)",
      "intf": "^Z2UI5_IF",
      "prog": "^Z",
      "fugr": "^Z",
      "tabl": "^Z",
      "ttyp": "^Z",
      "dtel": "^Z",
      "doma": "^Z",
      "msag": "^Z",
      "tran": "^Z",
      "enqu": "^EZ",
      "auth": "^Z",
      "pinf": "^Z",
      "idoc": "^Z",
      "xslt": "^Z",
      "ssfo": "^Z",
      "ssst": "^Z",
      "shlp": "^Z"
    },
    "range_row_values": true,
    "redundant_cast": true,
    "slow_parameter_passing": true,
    "smim_consistency": true,
    "sort_empty_key": true,
    // added 2026-11 with their findings fixed (abap2UI5 settings). Exception:
    // subrc_after_assign, ambiguous_statement, else_after_all_returns,
    // fully_type_itabs and unnecessary_chaining exclude z2ui5_cl_popup_context,
    // the vendored copy of abap-util (src/00/): it is not edited here, abap-util
    // is the place to fix it
    "short_case": true,
    "strict_sql": true,
    "subrc_after_assign": {
      "exclude": [
        "/src/00/z2ui5_cl_popup_context"
      ]
    },
    "use_bool_expression": true,
    "ambiguous_statement": {
      "exclude": [
        "/src/00/z2ui5_cl_popup_context"
      ]
    },
    "else_after_all_returns": {
      "exclude": [
        "/src/00/z2ui5_cl_popup_context"
      ]
    },
    "fully_type_itabs": {
      "exclude": [
        "/src/00/z2ui5_cl_popup_context"
      ]
    },
    "unnecessary_chaining": {
      "maxIssuesPerFile": 10,
      "ignoreExceptions": true,
      "exclude": [
        "/src/00/z2ui5_cl_popup_context"
      ]
    },
    // added 2026-11 with its findings fixed: UNASSIGN before an ASSIGN in a loop.
    // The ten in the vendored z2ui5_cl_popup_context were fixed in abap-util
    // (zabaputil_cl_util_context) and copied from there
    "is_assigned_in_loop": true,
    // added 2026-11: newer abaplint rules that report nothing here
    "abapdoc_short_link": true,
    "boolean_flag_via_if": true,
    "cast_via_generic_reference": true,
    // added 2026-11 on abaplint 2.120.116: every remaining rule of
    // `abaplint --default` is listed. Those that report nothing here, with
    // abap2UI5's settings (or the app rule set's, .github/abaplint/app-rules.json,
    // where abap2UI5 has none)
    "alias_never_reassigned": true,
    // the DEFAULT KEYs it reports sit only in z2ui5_cl_popup_context, the
    // vendored abap-util copy (src/00/) - fixed there, not here
    "avoid_use": {
      "exclude": [
        "/src/00/z2ui5_cl_popup_context"
      ],
      "skipQuickFix": false,
      "define": true,
      "statics": true,
      "defaultKey": true,
      "break": true,
      "testSeams": true,
      "describeLines": true,
      "exportToMemory": true,
      "exportToDatabase": true
    },
    "bdef_check_syntax": true,
    "bdef_parser_error": true,
    "cds_check_syntax": true,
    "cds_naming": {
      "basicInterfaceView": "Z2UI5_",
      "compositeInterfaceView": "Z2UI5_",
      "consumptionView": "Z2UI5_",
      "basicRestrictedReuseView": "Z2UI5_",
      "compositeRestrictedReuseView": "Z2UI5_",
      "privateView": "Z2UI5_",
      "remoteAPIView": "Z2UI5_",
      "viewExtend": "Z2UI5_",
      "extensionIncludeView": "Z2UI5_",
      "derivationFunction": "Z2UI5_",
      "abstractEntity": "Z2UI5_"
    },
    "character_field_literal_blanks": true,
    // the app rule set's settings: a SELECT into a table (or a single row
    // that stays initial) needs no sy-subrc of its own; the vendored
    // z2ui5_cl_popup_context is fixed in abap-util, not here
    "check_subrc": {
      "callFunction": true,
      "callMethod": true,
      "exclude": [
        "/src/00/z2ui5_cl_popup_context"
      ],
      "openDataset": true,
      "authorityCheck": true,
      "selectSingle": false,
      "selectTable": false,
      "updateDatabase": true,
      "insertDatabase": true,
      "modifyDatabase": true,
      "deleteDatabase": true,
      "readTable": true,
      "assign": true,
      "find": true
    },
    "copy_chain": true,
    // the value-help, search-help, message and data-element popups read a
    // table chosen at runtime (or one the cloud release must not name
    // statically) - dynamic SQL is switched off as in the app rule set; every
    // other dangerous statement stays reported
    "dangerous_statement": {
      "editorCallForReport": true,
      "ignoreRAPQueryProvider": true,
      "insertTextpool": true,
      "execSQL": true,
      "kernelCall": true,
      "systemCall": true,
      "insertReport": true,
      "generateDynpro": true,
      "generateReport": true,
      "generateSubroutine": true,
      "deleteReport": true,
      "deleteTextpool": true,
      "deleteDynpro": true,
      "exportDynpro": true,
      "dynamicSQL": false
    },
    "double_space": {
      "skipKeywords": ["CHANGING","EXPORTING","OTHERS"],
      "keywords": false,
      "startParen": true,
      "endParen": false,
      "afterColon": true
    },
    "field_symbol_never_assigned": true,
    // statements with a successor that this repository no longer uses -
    // listed so they do not come back (abaplint 2.120.116+). The
    // widely used READ TABLE / APPEND / CREATE OBJECT / ... follow
    // once the code no longer has them
    "forbidden_statement": {
      "statements": [
        "Describe",
        "Refresh",
        "Ranges",
        "SelectLoop",
        "Collect",
        "Overlay",
        "Leave",
        "TypePools",
        "Perform",
        "Form",
        "Write",
        "ReadTable",
        "Append",
        "CreateObject",
        "GetReference",
        "Concatenate",
        "Condense",
        "Translate",
        "Replace",
        "Find",
        "Shift",
        "Check"
      ],
      // MoveCorresponding stays allowed: z2ui5_cl_popup_to_select moves
      // between generic rows (TYPE any), which CORRESPONDING #( ) cannot take
      // the vendored abap-util copies stay close to the master (AGENTS.md)
      "exclude": [
        "/src/00/"
      ]
    },
    "function_module_parameter_names": true,
    "generic_regex": true,
    "indentation": true,
    "inline_generic_source": true,
    "keyword_case": {
      "ignoreGlobalClassDefinition": false,
      "ignoreGlobalInterface": false,
      "ignoreFunctionModuleName": false,
      "ignoreGlobalClassBoundaries": false,
      "maxIssuesPerFile": 10,
      "style": "upper",
      "ignoreExceptions": true,
      "ignoreLowerClassImplmentationStatement": true,
      "ignoreKeywords": []
    },
    // 255: the longest line abapGit and the ABAP editor accept
    "line_length": {
      "maxIssuesPerFile": 10,
      "length": 255
    },
    "loop_target_misuse": true,
    "no_macros": true,
    "prefer_raise_message": true,
    "selection_screen_texts_missing": true,
    "sequential_read_sorted": true,
    "sort_required": true,
    "space_before_colon": true,
    "space_before_dot": true,
    "stale_subrc": true,
    "start_at_tab": true,
    "suspicious_loop": true,
    "sy_read_restriction": true,
    "try_cast_empty_catch": true,
    "unit_test_assertions": true,
    "unnecessary_copy": true,
    // added 2026-11 with their findings fixed: the stub classes of the
    // z2ui5_cl_popup_demo_out test include renamed ltcl_ -> lcl_ (they are no
    // test classes), a single-use CAST inlined, INSERT LINES OF ... INTO TABLE
    // instead of APPEND, ORDER BY on the T002T / T100 / DD04T / DD04L reads
    // (the rows are sorted or looked up afterwards; INTO stays last)
    "local_class_naming": {
      "ignoreNames": [],
      "ignorePatterns": [],
      "patternKind": "required",
      "local": "^LCL_.+$",
      "exception": "^LCX_.+$",
      "test": "^LTCL_.+$"
    },
    "prefer_inline_cast": true,
    // added 2026-11 with abap2UI5's (or the app rule set's) settings; every
    // one of them excludes z2ui5_cl_popup_context (and, where it reports one,
    // z2ui5_cx_popup_error), the vendored copies of abap-util (src/00/): they
    // are not edited here, abap-util is the place to fix them (AGENTS.md).
    // Further narrow exceptions are named at the rule
    "align_pseudo_comments": {
      "exclude": [
        "/src/00/z2ui5_cl_popup_context"
      ]
    },
    "align_type_expressions": {
      "ignoreExceptions": true,
      "exclude": [
        "/src/00/z2ui5_cl_popup_context"
      ]
    },
    "check_comments": {
      "allowEndOfLine": false,
      "maxIssuesPerFile": 10,
      "exclude": [
        "/src/00/z2ui5_cl_popup_context"
      ]
    },
    "commented_code": {
      "allowIncludeInFugr": true,
      "exclude": [
        "/src/00/z2ui5_cl_popup_context"
      ]
    },
    "cyclomatic_complexity": {
      "exclude": [
        "/src/00/z2ui5_cl_popup_context"
      ],
      "max": 10
    },
    "line_only_punc": {
      "ignoreExceptions": true,
      "exclude": [
        "/src/00/z2ui5_cl_popup_context"
      ]
    },
    "method_length": {
      "checkFunctionModules": true,
      "exclude": [
        "/src/00/z2ui5_cl_popup_context"
      ],
      "statements": 50,
      "errorWhenEmpty": false,
      "ignoreTestClasses": true,
      "checkForms": true
    },
    "no_exclamation_escape": {
      "exclude": [
        "/src/00/z2ui5_cl_popup_context",
        "/src/00/z2ui5_cx_popup_error"
      ]
    },
    // z2ui5_cl_popup_to_select: both MOVE-CORRESPONDING move between generic
    // field symbols of a table built at runtime - CORRESPONDING needs a
    // static target type there
    "prefer_corresponding": {
      "exclude": [
        "/src/00/z2ui5_cl_popup_context",
        "/src/z2ui5_cl_popup_to_select"
      ]
    },
    "prefer_insert_into_table": {
      "exclude": [
        "/src/00/z2ui5_cl_popup_context"
      ]
    },
    // z2ui5_cl_popup_value_help: its dynamic SELECT ... UP TO n ROWS is
    // left half rewritten by the 702 downport once it has an ORDER BY, and the
    // ORDER BY would change which rows come back (see strict_sql above)
    "select_add_order_by": {
      "skipForAllEntries": false,
      "exclude": [
        "/src/00/z2ui5_cl_popup_context",
        "/src/03/z2ui5_cl_popup_value_help"
      ]
    },
    // z2ui5_cl_popup_image_edit: t_result is the public type of its result( )
    // - renaming it changes the signature callers in other systems use
    "types_naming": {
      "exclude": [
        "/src/00/z2ui5_cl_popup_context",
        "/src/z2ui5_cl_popup_image_edit"
      ],
      "pattern": "^TY_"
    },
    // z2ui5_cl_popup_shlp: catching error_message from F4IF_GET_SHLP_DESCR /
    // F4IF_EXPAND_SEARCHHELP would turn today's short dump into a handled
    // error path - a behaviour decision of its own, not a lint fix
    "unhandled_classic_exception": {
      "exclude": [
        "/src/00/z2ui5_cl_popup_context",
        "/src/03/z2ui5_cl_popup_shlp"
      ],
      "missingOthers": true,
      "missingExceptions": true,
      "missingErrorMessage": true,
      "allowLiteralArguments": true
    },
    // kept off. Layout rules that would fight the view-builder chain layout
    // (.claude/skills/view-chain-layout in abap2UI5): one call per line, n/v
    // on two lines, a blank line opening a control's content, end( ) in the
    // column of the ele( ) it closes - off in abap2UI5 and in the app rule set
    // as well
    "align_parameters": false,
    "empty_line_in_statement": true, // 0 findings here - on, so none come back (off in the abap2UI5 core)
    "in_statement_indentation": false,
    "keep_single_parameter_on_one_line": false,
    "line_break_multiple_parameters": false,
    // inlining a temporary into its single use would pull whole builder chains
    // (toolbar, header, the popup under test) into a parameter list
    "single_use_expression_temp": false,
    // naming conventions this repository does not follow (no Hungarian
    // prefixes required) - off in abap2UI5 and in the app rule set
    "class_attribute_names": false,
    "local_variable_names": false,
    "method_parameter_names": false,
    "no_prefixes": false,
    // the popups hand their result over in public attributes (ms_result and
    // the like) by design - callers in other repositories and systems read
    // them; off in abap2UI5 and the app rule set
    "no_public_attributes": false,
    // style preferences abap2UI5 and the app rule set both keep off.
    // abapdoc: ABAP Doc for 131 public methods is writing, not a fix;
    // prefer_inline: the declarations it reports carry a type the inline form
    // would change (p LENGTH 8 DECIMALS 2, c LENGTH 30 for a function module
    // parameter, decfloat34); prefer_string_template: the long HTML/CSS/JS
    // texts are joined with && to stay under 255 characters, a template would
    // have to escape every { }; no_inline_in_optional_branches: LOOP AT ...
    // INTO DATA( ) is the house style
    "abapdoc": false,
    "no_inline_in_optional_branches": false,
    "prefer_inline": false,
    "prefer_string_template": false,
    // the value help, search help, to_select and the samples work on tables
    // and types chosen at runtime (ASSIGN COMPONENT, CREATE DATA TYPE HANDLE,
    // SELECT FROM (name)) - dynamic by nature
    "no_dynamic_stuff": false
  }
}
